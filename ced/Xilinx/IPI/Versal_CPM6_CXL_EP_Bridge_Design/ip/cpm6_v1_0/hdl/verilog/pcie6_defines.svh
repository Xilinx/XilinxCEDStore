`define PCIE6_FLT_Q_ADDR_WIDTH 64
`define PCIE6_CX_NPRFX 3
`define PCIE6_CX_NVC 4'd1
`define PCIE6_CX_HCRD_WD 12
`define PCIE6_CX_DCRD_WD 16

`define PCIE6_PSTBR_PL_RX_SLOT_NUM 3
`define PCIE6_PSTBR_PL_RX_SLOT_WIDTH $bits(pstbr_rtrgt1_np_no_data_hdr_t)*3
`define PCIE6_PSTBR_PL_RX_DATA_WIDTH `PCIE6_PSTBR_PL_RX_SLOT_WIDTH*`PCIE6_PSTBR_PL_RX_SLOT_NUM 
`define PCIE6_PSTBR_PL_RX_DATA_PARITY_WIDTH 42
`define PCIE6_PSTBR_PL_RX_START_WIDTH `PCIE6_PSTBR_PL_RX_SLOT_NUM
`define PCIE6_PSTBR_PL_RX_STARTPTR_WIDTH 2
`define PCIE6_PSTBR_PL_RX_END_WIDTH `PCIE6_PSTBR_PL_RX_SLOT_NUM
`define PCIE6_PSTBR_PL_RX_ENDPTR_WIDTH (`PCIE6_PSTBR_PL_RX_STARTPTR_WIDTH+4)
`define PCIE6_PSTBR_PL_RX_STARTTYPE_WIDTH 2
`define PCIE6_PSTBR_PL_RX_STARTNPINFO_WIDTH 3
`define PCIE6_PSTBR_PL_RX_END_ERROR_WIDTH 9
`define PCIE6_PSTBR_PL_RX_CREDIT_BUS_WIDTH 3

`define PCIE6_PSTBR_PL_TX_SLOT_NUM 3
`define PCIE6_PSTBR_PL_TX_SLOT_WIDTH $bits(pstbr_pl_tx_xali_np_no_data_hdr_t)*3
`define PCIE6_PSTBR_PL_TX_DATA_WIDTH `PCIE6_PSTBR_PL_TX_SLOT_WIDTH*`PCIE6_PSTBR_PL_TX_SLOT_NUM
`define PCIE6_PSTBR_PL_TX_DATA_PARITY_WIDTH 40
`define PCIE6_PSTBR_PL_TX_START_WIDTH `PCIE6_PSTBR_PL_TX_SLOT_NUM
`define PCIE6_PSTBR_PL_TX_STARTPTR_WIDTH 2
`define PCIE6_PSTBR_PL_TX_END_WIDTH `PCIE6_PSTBR_PL_TX_SLOT_NUM
`define PCIE6_PSTBR_PL_TX_ENDPTR_WIDTH (`PCIE6_PSTBR_PL_TX_STARTPTR_WIDTH+4)
`define PCIE6_PSTBR_PL_TX_STARTTYPE_WIDTH 2
`define PCIE6_PSTBR_PL_TX_STARTNPINFO_WIDTH 3
`define PCIE6_PSTBR_PL_TX_END_ERROR_WIDTH 9
`define PCIE6_PSTBR_PL_TX_CREDIT_BUS_WIDTH 3

//------------------------
// PSTBR Async FIFOS
