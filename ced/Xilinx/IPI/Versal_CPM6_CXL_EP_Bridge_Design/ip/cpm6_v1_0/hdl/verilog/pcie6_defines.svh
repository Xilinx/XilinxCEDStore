`define PCIE6_PSTBR_SNPS_DATA_WIDTH 512
`define PCIE6_PSTBR_PL_RX_CRDT_CNTR_WIDTH 8
`define PCIE6_PSTBR_PL_TX_CRDT_CNTR_WIDTH 8
