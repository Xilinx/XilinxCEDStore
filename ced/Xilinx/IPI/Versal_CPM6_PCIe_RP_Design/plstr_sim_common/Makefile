## =============================================================================
## Makefile - CPM6 PCIe Gen6 Root Port Simulation (PL_STR)
## =============================================================================
## Usage:
##   make cos                     -- compile + optimize + simulate
##   make cos DUMP=1              -- with waveform dump
##   make s TEST=test_mem_tlp SEED=12345 -- re-simulate with a specific seed
##   make smoke                   -- run the smoke test (test_rp_traffic) only
##   make regr TESTLIST=<file>    -- run every test listed in <file>
##   make clean                   -- clean sim outputs
##   make aclean                  -- clean everything (keep clibs)
##   make fullclean                -- factory reset
##   make distclean                                 -- wipe all compiled libs (uvm, avery, uvma_agents, cpm6_secip, Vivado vcs_lib), full rebuild
## =============================================================================

## ----------------------------------------------------------------------------
## TEST -- change to run a different test
## ----------------------------------------------------------------------------
## RP PL-streaming tests come from test/ (the simulation directory is
## assembled from three sources: sim/, plstr_sim_common/ and <variant>/sim/):
##   test_rp_traffic   (default) RP/EP enumeration from the ROM vectors, then
##                               TRAFFIC_COUNT mem rd/wr; DUT error counters are
##                               cross-checked against the scoreboards
##   test_mem_tlp      base test - enumeration only, no traffic loop
##
## The test is controller-agnostic: it loops over dut_ctrlr_en, which is set
## from the +CTRLR0_EN / +CTRLR1_EN plusargs derived from CTRL below. The same
## file therefore serves Controller_0 and Controller_1 without editing.
## ----------------------------------------------------------------------------
TEST  ?= test_rp_traffic
DUMP  ?= 0
SEED  ?=
REGR_TIMEOUT ?= 3600
TESTLIST ?= testlist_smoke.txt

## ----------------------------------------------------------------------------
## Auto-detect Vivado project (works regardless of project name)
## ----------------------------------------------------------------------------
PROJ_ROOT  := $(shell find ../ -maxdepth 2 -name "*.xpr" -exec dirname {} \; 2>/dev/null | head -1)
# -prune past simv.daidir: VCS mirrors the full absolute path inside
# simv.daidir/scsim.db.dir/cfg/, so a bare find picks that decoy copy of
# .../sim_1/behav/vcs and every downstream path silently points at nothing
# ("compile.sh not found" while compile.sh sits in the real directory).
VIVADO_SIM := $(shell find $(PROJ_ROOT) \( -name "simv.daidir" -o -name "csrc" \) -prune -o \
                      -path "*/sim_1/behav/vcs" -type d -print 2>/dev/null | head -1)
CLIBS      := $(abspath clibs)

## Vivado install root, recovered from the absolute paths Vivado baked into
## compile.sh, and the matching VCS compiled-library directory. Override
## VIVADO_CLIBS on the command line if the auto-derived one is wrong.
VIVADO_ROOT  := $(shell grep -m1 -oE "/[^ \"]*/installs/lin64/[0-9.]+/data" \
                  "$(VIVADO_SIM)/compile.sh" 2>/dev/null | sed 's|/installs/.*||')
VIVADO_CLIBS ?= $(firstword $(wildcard $(VIVADO_ROOT)/clibs/vcs/*/lin64/lib))
SIM_SETUP  := $(abspath sim_setup.setup)

## ----------------------------------------------------------------------------
## Auto-detect link width and lane rate from defines file generated by CED
## ----------------------------------------------------------------------------
DEFINES_FILE := $(shell find $(PROJ_ROOT) -name "defines.sv" 2>/dev/null | head -1)
WIDTH        := $(shell grep -oE "LINK_WIDTH[^;]*[0-9]+" "$(DEFINES_FILE)" 2>/dev/null | grep -oE "[0-9]+")
ifeq ($(strip $(WIDTH)),)
  WIDTH := 4
endif
LANE_RATE    := $(shell grep -o 'LANE_RATE.*"[^"]*"' "$(DEFINES_FILE)" 2>/dev/null | grep -o '"[^"]*"' | tr -d '"')

## Controller selection, scraped the same way as LINK_WIDTH / LANE_RATE above.
## run.tcl writes `parameter CTRL = 0|1;` into defines.sv from the CED's
## CTRL_CONFIG radio button, so the simulation always follows the controller
## the design was actually generated for.
CTRL         := $(shell grep -oE "CTRL[[:space:]]*=[[:space:]]*[0-9]+" "$(DEFINES_FILE)" 2>/dev/null | grep -oE "[0-9]+")
ifeq ($(strip $(CTRL)),)
  $(warning CTRL not found in "$(DEFINES_FILE)" -- defaulting to 1. Regenerate \
            the project if this is a Controller_0 design.)
  CTRL := 1
endif

ifeq ($(CTRL),0)
  LINK0_W   := $(WIDTH)
  LINK1_W   := 0
  ECAM_BASE := 0x600000000
else
  LINK0_W   := 0
  LINK1_W   := $(WIDTH)
  ECAM_BASE := 0x700000000
endif

ifeq ($(LANE_RATE),64.0_GT/s)
  CTRLR1_SPEED := 6
  CTRLR1_FM    := 1
else ifeq ($(LANE_RATE),32.0_GT/s)
  CTRLR1_SPEED := 5
  CTRLR1_FM    := 0
else
  CTRLR1_SPEED := 4
  CTRLR1_FM    := 0
endif

## ----------------------------------------------------------------------------
## Auto-detect PL0 clock from Vivado-generated file
## ----------------------------------------------------------------------------
PMCPS_V := $(shell find $(PROJ_ROOT) -name "*pmcps_0_0.v" 2>/dev/null | head -1)
ifneq ($(PMCPS_V),)
  PL0_CLK := $(shell grep -o "PL0_REF_CLK.*FREQ_HZ [0-9]*" "$(PMCPS_V)" 2>/dev/null | \
              awk '{print $$3}' | sed -E 's/([0-9]+)([0-9]{6})$$/\1.\2/' | head -1)
endif

## ----------------------------------------------------------------------------
## Compilation defines
## ----------------------------------------------------------------------------
CDEF := +define+CPM6_VIVADO         \
        +define+PCIE_LINK_PIPE       \
        +define+CPM6_DECRYPTED_SIP   \
        +define+APCI_MAX_DATA_WIDTH=8 \
        +define+VCS_SIM

## ----------------------------------------------------------------------------
## Simulation plusargs
## ----------------------------------------------------------------------------
## Default run verbosity. LOW keeps the configuration header, the transaction
## flow (rp_flow_log.txt and the RP_FLOW lines) and the result banner, while
## filtering per-transaction testbench plumbing. Raise it when debugging:
##   make s VERBOSITY=MEDIUM     per-check detail, credit updates, monitors
##   make s VERBOSITY=HIGH       + full TLP object dumps
VERBOSITY ?= LOW

PARG  := +CTRLR0_EN=$(if $(filter 0,$(CTRL)),1,0)
PARG  += +CTRLR1_EN=$(if $(filter 0,$(CTRL)),0,1)
PARG  += +ECAM_BASE=$(ECAM_BASE)
PARG  += +CTRLR0_SPEED=$(CTRLR1_SPEED)
PARG  += +CTRLR0_FM=$(CTRLR1_FM)
PARG  += +CTRLR1_SPEED=$(CTRLR1_SPEED)
PARG  += +CTRLR1_FM=$(CTRLR1_FM)
PARG  += +SIM_TIMEOUT=5000us
PARG  += +CPM6_VIVADO
PARG  += +PCIE_LINK_PIPE
ifneq ($(PL0_CLK),)
  PARG += +PL0_CLK=$(PL0_CLK)
endif

## ----------------------------------------------------------------------------
## Seed plusarg -- SEED unset means automatic (matches
## uvma-pcie-sim-framework/sim_common/Makefile.testcase_vars convention)
## ----------------------------------------------------------------------------
ifeq ($(SEED),)
  SEED_ARG := +ntb_random_seed_automatic
else
  SEED_ARG := +ntb_random_seed=$(SEED)
endif

## ----------------------------------------------------------------------------
## C shared libraries -- relative from sim/ODIR/ where simv runs
## ----------------------------------------------------------------------------
SIM_SO := -sv_lib ../lib/date -sv_lib ../lib/socket_dpi

## =============================================================================
## TARGETS
## =============================================================================

.PHONY: h help cos c compile o opt s sim smoke regr wave clean cln aclean acln fullclean distclean _stage_mem

h help:
	@echo "======================================================="
	@echo " CPM6 PCIe Gen6 Root Port Simulation (PL_STR)"
	@echo "======================================================="
	@echo ""
	@echo " Prerequisites:"
	@echo "   1. VCS / Verdi           : X-2025.06"
	@echo "   2. Avery PLI / PCIe VIP  : 2025.3_1"
	@echo "                              (AVERY_PLI, AVERY_PCIE, AVERY_SIM)"
	@echo "   3. Set CPM6 Secure IP   : setenv CPM6_SECUREIP <path>    (tcsh)"
	@echo "                              export CPM6_SECUREIP=<path>   (bash)"
	@echo "                              (download separately, see README)"
	@echo "   4. Create project from CED in Vivado"
	@echo "   5. Set Compiled Libraries Dir in Vivado (2026.1.1 clibs)"
	@echo "   6. Run launch_simulation -scripts_only in Vivado"
	@echo ""
	@echo " Targets:"
	@echo "   make cos      - Compile + Optimize + Simulate"
	@echo "   make c        - Compile only"
	@echo "   make o        - Optimize only"
	@echo "   make s        - Simulate only"
	@echo "   make smoke    - Run the smoke test (test_rp_traffic) only"
	@echo "   make regr TESTLIST=<file> - Run every test listed in <file>"
	@echo "   make wave     - Simulate with waveform dump (alias for 's DUMP=1')"
	@echo "   make clean    - Clean simulation outputs"
	@echo "   make aclean   - Clean (keeps pre-compiled clibs)"
	@echo "   make fullclean- Factory reset"
	@echo ""
	@echo " Options:"
	@echo "   TEST=<name>       Test name (default: $(TEST))"
	@echo "   SEED=<n>          Random seed (default: automatic)"
	@echo "   REGR_TIMEOUT=<s>  Per-test timeout in seconds (default: $(REGR_TIMEOUT))"
	@echo "   DUMP=<0|1>        Waveform dump: 0=off, 1=on (default: $(DUMP))"
	@echo ""
	@echo " Auto-detected:"
	@echo "   Project    : $(PROJ_ROOT)"
	@echo "   Width      : $(WIDTH)"
	@echo "   Lane Rate  : $(LANE_RATE)"
	@echo "   Speed      : $(CTRLR1_SPEED)"
	@echo "   Flit Mode  : $(CTRLR1_FM)"
	@echo "   PL0_CLK    : $(PL0_CLK)"

cos: c o s

## ---------------------------------------------------------------------------
## COMPILE
## ---------------------------------------------------------------------------
c compile: _check_env _check_vivado
	@echo ""
	@echo "=== COMPILE STEP 1/3: UVM + uvma_agents Libraries ==="
	@if [ ! -d $(CLIBS)/uvm ]; then \
	    mkdir -p $(CLIBS)/uvm; \
	    SYNOPSYS_SIM_SETUP=$(abspath vcs_lib_map.setup) \
	    vlogan -full64 -sverilog -work uvm -ntb_opts uvm-1.1 \
	           -timescale=1ps/1ps \
	           +define+UVM_DISABLE_AUTO_ITEM_RECORDING \
	           -l $(CLIBS)/vlogan.uvm.log; \
	    echo "    UVM compiled"; \
	else \
	    echo "    UVM already compiled -- skipping"; \
	fi
	@if [ ! -d $(CLIBS)/uvma_agents ]; then \
	    mkdir -p $(CLIBS)/uvma_agents; \
	    SYNOPSYS_SIM_SETUP=$(abspath vcs_lib_map.setup) \
	    vlogan -full64 -sverilog -work uvma_agents -ntb_opts uvm-1.1 \
	           -timescale=1ns/1ps -kdb \
	           +define+TIME_BASE_PKG \
	           +define+TIMEUNIT_BASE_PKG=1ps \
	           +define+TIMEPREC_BASE_PKG=1ps \
	           -l $(CLIBS)/vlogan.uvma_agents.log \
	           -F uvma_agents.f; \
	    echo "    uvma_agents compiled"; \
	else \
	    echo "    uvma_agents already compiled -- skipping"; \
	fi
	@if [ ! -d $(CLIBS)/avery ]; then \
	    mkdir -p $(CLIBS)/avery; \
	    SYNOPSYS_SIM_SETUP=$(abspath vcs_lib_map.setup) \
	    vlogan -full64 -sverilog -work avery -ntb_opts uvm-1.1 \
	           +define+APCI_MAX_DATA_WIDTH=8 \
	           -l $(CLIBS)/vlogan.avery.log \
	           -f avery_vcs.f; \
	    echo "    avery compiled"; \
	else \
	    echo "    avery already compiled -- skipping"; \
	fi
	@echo ""
	@echo "=== COMPILE STEP 2/3: Vivado DUT ==="
	@if [ ! -f $(VIVADO_SIM)/vcs_lib/xil_defaultlib/work.lib++ ]; then \
	    echo "    Running Vivado compile.sh ..."; \
	    ( cd $(VIVADO_SIM) && bash compile.sh ) || { \
	        echo ""; echo "ERROR: Vivado compile.sh failed -- see $(VIVADO_SIM)/.tmp_log"; \
	        echo ""; exit 1; }; \
	    echo "    Vivado DUT compiled"; \
	else \
	    echo "    Vivado DUT already compiled -- skipping"; \
	fi
	@echo "    Generating VCS library setup ..."
	@$(MAKE) --no-print-directory _gen_sim_setup
	@if [ ! -d $(CLIBS)/cpm6_secip ]; then \
	    mkdir -p $(CLIBS)/cpm6_secip; \
	    SYNOPSYS_SIM_SETUP=$(SIM_SETUP) \
	    vlogan -full64 -sverilog -work cpm6_secip \
	           -timescale=1ns/1ps -kdb \
	           -l $(CLIBS)/vlogan.cpm6_secip.log \
	           -F cpm6_sip.f; \
	    echo "    cpm6_secip compiled"; \
	else \
	    echo "    cpm6_secip already compiled -- skipping"; \
	fi
	@echo ""
	@echo "=== COMPILE STEP 3/3: Top-level Testbench ==="
	@ ## The four packages in plstr_src/intf, rebuilt into `work` so the TB resolves
	@ ## them from its own library (compile.sh has already built them into
	@ ## xil_defaultlib for the DUT). This vlogan line precedes -f tb_files.f, so
	@ ## test/interfaces/*.sv resolve against them.
	@ ##
	@ ## ORDER MATTERS. pkg.pcie_intf_pkg.sv references pcie_str_pkg::RX_SLOT_WIDTH,
	@ ## pcie_str_pkg::TX_SLOT_WIDTH, pcie_str_pkg::MAX_SUB_SLOTS and pcie_rp_pkg::
	@ ## by scope resolution rather than by `import`, so it must compile last -
	@ ## a plain alphabetical glob puts it first and every reference fails with
	@ ## Error-[SV-EEM-SRE]. cfg_status_pkg, pcie_rp_pkg and pcie_str_pkg have no
	@ ## cross-references, so their relative order is free.
	$(eval PROJ_PKGS := \
	    $(shell find $(PROJ_ROOT) -path "*/imports/intf/pkg.*.sv" \
	        ! -name "pkg.pcie_intf_pkg.sv" 2>/dev/null | sort) \
	    $(shell find $(PROJ_ROOT) -path "*/imports/intf/pkg.pcie_intf_pkg.sv" 2>/dev/null))
	SYNOPSYS_SIM_SETUP=$(SIM_SETUP) \
	vlogan -full64 -sverilog -work work -ntb_opts uvm-1.1 \
	       -timescale=1ns/1ps -kdb +warn=noCVMBI \
	       $(CDEF) \
	       -l vcs.vlogan.log \
	       $(PROJ_PKGS) \
	       -f tb_files.f
	@echo "    Testbench compiled"

## ---------------------------------------------------------------------------
_gen_sim_setup:
	@echo "LIBRARY_SCAN=TRUE"                              >  sim_setup.setup
	@echo "work        : $(abspath workvcs)"               >> sim_setup.setup
	@echo "uvm         : $(CLIBS)/uvm"                     >> sim_setup.setup
	@echo "avery       : $(CLIBS)/avery"       >> sim_setup.setup
	@echo "uvma_agents : $(CLIBS)/uvma_agents" >> sim_setup.setup
	@echo "cpm6_secip  : $(CLIBS)/cpm6_secip"  >> sim_setup.setup
	@for lib in $(VIVADO_SIM)/vcs_lib/*/; do \
	    libname=$$(basename $$lib); \
	    echo "$$libname : $$(realpath $$lib)"              >> sim_setup.setup; \
	done
	@VIVADO_OTHERS=$$(grep "^OTHERS=" $(VIVADO_SIM)/synopsys_sim.setup 2>/dev/null | \
	                  sed 's/OTHERS=//' | head -1); \
	 case "$$VIVADO_OTHERS" in \
	   ""|*'?'*) \
	     echo "    NOTE: Vivado's OTHERS= is unresolved ('$$VIVADO_OTHERS') -- omitting."; \
	     echo "          Set VIVADO_CLIBS before generating the project to resolve it."; \
	     ;; \
	   *) echo "OTHERS=$$VIVADO_OTHERS"                    >> sim_setup.setup; ;; \
	 esac
	@echo "    sim_setup.setup generated"

## ---------------------------------------------------------------------------
## OPTIMIZE
## ---------------------------------------------------------------------------
o opt: _check_env _check_setup
	@echo ""
	@echo "=== OPTIMIZE STEP 2/3: Linking ==="
	SYNOPSYS_SIM_SETUP=$(SIM_SETUP) \
	vcs -j4 -full64 +nospecify -xlrm uniq_prior_final -ntb_opts uvm-1.1 \
	    -l vcs.opt.log \
	    work.tb_top xil_defaultlib.glbl \
	    +warn=noCNST-PPRW,noRT-NCMUCS,noUNGB \
	    -debug_access+all \
	    $(AVERY_PLI)/lib.linux/libtb_vcs64.a \
	    -P $(AVERY_PLI)/tb_vcs64.tab +vpi \
	    +warn=noUII-L -reportstats \
	    -pvalue tb_top.LINK0_WIDTH=$(LINK0_W) \
	    -pvalue tb_top.LINK1_WIDTH=$(LINK1_W)
	@echo "    Optimization complete -- simv created"

## ---------------------------------------------------------------------------
## SIMULATE
## ---------------------------------------------------------------------------
s sim: _check_env _check_simv _check_setup _stage_mem
	@echo ""
	@echo "=== SIMULATE STEP 3/3: Running $(TEST) ==="
	@echo "    Width        : $(WIDTH)"
	@echo "    PL0_CLK      : $(PL0_CLK)"
	@echo "    DUMP         : $(DUMP)"
	@echo "    SEED_ARG     : $(SEED_ARG)"
	@echo "    REGR_TIMEOUT : $(REGR_TIMEOUT)s"
	@cp $(VIVADO_SIM)/*.cdo . 2>/dev/null || true
	@cp $(VIVADO_SIM)/*.mem . 2>/dev/null || true
	@rm -f uclirun.do
	@if [ "$(DUMP)" = "1" ]; then \
	    echo 'fsdbDumpvars 0 tb_top +all +trace_process' >> uclirun.do; \
	fi
	@echo "run" >> uclirun.do
	@ODIR=$(TEST)_$$(date +"%m%d%y_%Hh%Mm%Ss"); \
	 mkdir -p $$ODIR; \
	 cp $(VIVADO_SIM)/*.dat $$ODIR/ 2>/dev/null || true; \
	 export SYNOPSYS_SIM_SETUP=$(SIM_SETUP); \
	 cd $$ODIR && timeout $(REGR_TIMEOUT) ../simv \
	    -no_save \
	    -l vcs.sim.log \
	    -reportstats \
	    -licqueue -licwait 1 \
	    $(SEED_ARG) \
	    $(SIM_SO) \
	    +UVM_TESTNAME=$(TEST) \
	    +UVM_VERBOSITY=UVM_$(VERBOSITY) \
	    -ucli -do ../uclirun.do \
	    $(PARG); \
	 SIMV_RC=$$?; \
	 echo ""; \
	 echo "//-------------------------------------------//"; \
	 echo "// TEST : $(TEST)"; \
	 grep -E "UVM_ERROR|UVM_FATAL|\[TEST_DONE\]" vcs.sim.log | tail -5; \
	 NERR=$$(grep -oE "UVM_ERROR *: *[0-9]+" vcs.sim.log | grep -oE "[0-9]+" | tail -1); \
	 NFTL=$$(grep -oE "UVM_FATAL *: *[0-9]+" vcs.sim.log | grep -oE "[0-9]+" | tail -1); \
	 NWRN=$$(grep -oE "UVM_WARNING *: *[0-9]+" vcs.sim.log | grep -oE "[0-9]+" | tail -1); \
	 if [ $$SIMV_RC -eq 124 ]; then \
	    echo "// RESULT : TIMEOUT (exceeded $(REGR_TIMEOUT)s)"; \
	 elif [ -z "$$NERR" ] && [ -z "$$NFTL" ]; then \
	    echo "// RESULT : ERROR OCCURED (no UVM report counts found)"; \
	 elif [ "$${NFTL:-0}" -ne 0 ]; then \
	    echo "// RESULT : FATAL"; \
	 elif [ "$${NERR:-0}" -ne 0 ]; then \
	    echo "// RESULT : FAIL WITH $$NERR ERRORS"; \
	 elif [ "$${NWRN:-0}" -ne 0 ]; then \
	    echo "// RESULT : PASS WITH $$NWRN WARNINGS"; \
	 else \
	    echo "// RESULT : PASS"; \
	 fi; \
	 echo "// LOG  : sim/$$ODIR/vcs.sim.log"; \
	 echo "//-------------------------------------------//"

## ---------------------------------------------------------------------------
## ROM staging
## ---------------------------------------------------------------------------
## config_mem_handler.sv reads its RP/EP ROM vectors with
## $readmemh("../mem/<name>.hex"). In synthesis that path resolves against the
## source file; in simulation it resolves against the cwd, and simv runs from
## sim/$(TEST)_<timestamp>/. The ROMs therefore have to be staged at sim/mem/.
## run.tcl puts them in the project at imports/mem/.
_stage_mem:
	@mem_src=$$(find $(PROJ_ROOT) -type d -path "*/imports/mem" 2>/dev/null | head -1); \
	 if [ -z "$$mem_src" ]; then \
	    echo ""; echo "ERROR: ROM directory imports/mem not found under $(PROJ_ROOT)."; \
	    echo "       Regenerate the project - run.tcl stages the .hex files there."; echo ""; exit 1; \
	 fi; \
	 rm -rf ./mem; cp -r "$$mem_src" ./mem; \
	 echo "    ROMs staged: $$(ls ./mem/*.hex 2>/dev/null | wc -l) .hex from $$mem_src"

## ---------------------------------------------------------------------------
## SMOKE / REGRESSION
## ---------------------------------------------------------------------------
smoke:
	@$(MAKE) --no-print-directory s TEST=test_rp_traffic

regr:
	@if [ ! -f "$(TESTLIST)" ]; then \
	    echo "ERROR: testlist file not found: $(TESTLIST)"; exit 1; \
	fi
	@SUMMARY=SUMMARY_$$(date +"%m%d%y_%Hh%Mm%Ss").log; \
	 TOTAL=0; \
	 for t in $$(grep -v -E "^\s*#|^\s*$$" $(TESTLIST)); do \
	    TOTAL=$$((TOTAL+1)); \
	    echo ""; \
	    echo "=== REGRESSION: running $$t ($(TESTLIST)) ==="; \
	    $(MAKE) --no-print-directory s TEST=$$t 2>&1 | tee -a $$SUMMARY; \
	 done; \
	 PASS_CNT=$$(grep -c "RESULT : PASS" $$SUMMARY); \
	 echo ""; \
	 echo "//-------------------------------------------//"; \
	 echo "// REGRESSION SUMMARY: $$PASS_CNT/$$TOTAL PASSED"; \
	 echo "// LOG  : sim/$$SUMMARY"; \
	 echo "//-------------------------------------------//"

wave:
	@$(MAKE) --no-print-directory s DUMP=1

## ---------------------------------------------------------------------------
## CLEAN
## ---------------------------------------------------------------------------
clean cln:
	@rm -f *.log *.cdo *.mem uclirun.do ucli.key simv vc_hdrs.h novas* inter.fsdb
	@rm -rf csrc simv.daidir workvcs verdi_config_file mem
	@echo "Cleaned simulation outputs"

aclean acln: clean
	@rm -rf sim_setup.setup clibs/uvm
	@echo "Full clean done (pre-compiled clibs preserved)"

fullclean:
	@echo "======================================================="
	@echo " FULL CLEAN -- resets to factory state"
	@echo " Pre-compiled clibs preserved"
	@echo "======================================================="
	@rm -rf workvcs sim_setup.setup clibs/uvm
	@rm -rf simv simv.daidir simv.vdb csrc verdiLog
	@rm -f *.log *.cdo *.mem uclirun.do ucli.key vc_hdrs.h novas* inter.fsdb
	@find . -maxdepth 1 -type d -name "test_*" -exec rm -rf {} + 2>/dev/null || true
	@echo "Full clean complete"

distclean: fullclean
	@echo "======================================================="
	@echo " DIST CLEAN -- removes ALL generated/compiled libraries"
	@echo " (uvm, avery, uvma_agents, cpm6_secip, Vivado vcs_lib)"
	@echo " Next 'make cos' will recompile everything from scratch"
	@echo "======================================================="
	@rm -rf clibs work.lib++
	@if [ -n "$(VIVADO_SIM)" ]; then \
	    rm -rf $(VIVADO_SIM)/vcs_lib; \
	    mkdir -p $(VIVADO_SIM)/vcs_lib; \
	    rm -f $(VIVADO_SIM)/*.log $(VIVADO_SIM)/.tmp_log; \
	fi
	@echo "Dist clean complete"

## ---------------------------------------------------------------------------
## Internal checks
## ---------------------------------------------------------------------------
_check_env:
	@if [ -z "$(AVERY_PLI)" ]; then \
	    echo ""; echo "ERROR: AVERY_PLI not set. Avery PLI 2025.3_1 is required."; echo ""; exit 1; \
	elif [ -z "$(findstring 2025.3_1,$(AVERY_PLI))" ]; then \
	    echo ""; echo "ERROR: AVERY_PLI must be set to <path>/avery_pli-2025.3_1 (found: $(AVERY_PLI))."; \
	    echo "       Set it to the avery_pli-2025.3_1 install."; echo ""; exit 1; fi
	@if [ -z "$(AVERY_PCIE)" ]; then \
	    echo ""; echo "ERROR: AVERY_PCIE not set. Avery PCIe VIP 2025.3_1 is required."; echo ""; exit 1; fi
	@if [ -z "$(AVERY_SIM)" ]; then \
	    echo ""; echo "ERROR: AVERY_SIM not set. Avery sim libraries 2025.3_1 are required."; echo ""; exit 1; fi
	@if [ -z "$(VCS_HOME)" ]; then \
	    echo ""; echo "ERROR: VCS_HOME not set."; echo ""; exit 1; \
	elif [ ! -d "$(VCS_HOME)/etc/uvm-1.1" ]; then \
	    echo ""; echo "ERROR: $(VCS_HOME)/etc/uvm-1.1 does not exist -- VCS_HOME points to an"; \
	    echo "       incomplete/incompatible VCS install. VCS X-2025.06 is required."; echo ""; exit 1; fi
	@if [ -z "$(CPM6_SECUREIP)" ]; then \
	    echo ""; echo "ERROR: CPM6_SECUREIP not set."; \
	    echo "       Download CPM6 Secure IP and set CPM6_SECUREIP:"; \
	    echo "         tcsh: setenv CPM6_SECUREIP <path>"; \
	    echo "         bash: export CPM6_SECUREIP=<path>"; echo ""; exit 1; fi
	@if [ -z "$(VIVADO_SIM)" ]; then \
	    echo ""; echo "ERROR: Vivado project not found in ../"; \
	    echo "       Create project from CED in Vivado first."; echo ""; exit 1; fi
	@if ! command -v cdoutil >/dev/null 2>&1; then \
	    echo ""; echo "ERROR: cdoutil not on PATH. Vivado is needed at SIMULATION time,"; \
	    echo "       not only to build the project: dut_config.sv strips the CHIPPIPE"; \
	    echo "       programming out of the CDO for a PIPE sim and re-encodes it with"; \
	    echo "       cdoutil. Without it the run dies at time 0 with"; \
	    echo "       UVM_FATAL [ERRCALL] Return value non-zero."; \
	    echo "       Source the matching Vivado, e.g."; \
	    echo "         source $(VIVADO_ROOT)/installs/lin64/<ver>/Vivado/settings64.sh"; \
	    echo ""; exit 1; fi

_check_vivado:
	@if [ ! -f "$(VIVADO_SIM)/compile.sh" ]; then \
	    echo ""; echo "ERROR: compile.sh not found."; \
	    echo "       Run launch_simulation -scripts_only in Vivado first."; echo ""; exit 1; fi

_check_simv:
	@if [ ! -f "simv" ]; then \
	    echo ""; echo "ERROR: simv not found. Run 'make c o' first."; echo ""; exit 1; fi

_check_setup:
	@if [ ! -f "sim_setup.setup" ]; then \
	    echo ""; echo "ERROR: sim_setup.setup not found. Run 'make c' first."; echo ""; exit 1; fi
